# Security
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REMEMBER_SESSION_DAYS=30

# Network
DOMAIN=localhost
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Metadata
TMDB_API_KEY=
TMDB_TOKEN=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT=StreamVaultDebug/1.0

# Infrastructure
CHECK_INTERVAL_MINUTES=30
HOST_DATA_ROOT=./data
# Optional: set BOTH to override the Git checkout's configured upstream.
# UPDATE_REMOTE names an existing remote; repository URLs are never guessed.
UPDATE_REMOTE=
UPDATE_BRANCH=
# Optional initial defaults. Admin UI settings are persisted under DATA_ROOT.
# branch preserves the existing behavior; release follows published stable tags.
UPDATE_MODE=branch
UPDATE_PROVIDER=auto
UPDATE_API_URL=
UPDATE_REPOSITORY=
UPDATE_CHECK_INTERVAL_HOURS=24
CONCURRENT_DOWNLOADS=1
DOWNLOAD_RATE_LIMIT=4194304
TORRENT_UPLOAD_RATE_LIMIT=65536
DOWNLOADER_CPUS=1.0
DOWNLOADER_MEMORY_LIMIT=768m
TUNNEL_MEMORY_LIMIT=512m
TUNNEL_PROTOCOL=http2

# Cloudflare Tunnel (Optional: activate tunnel directly from .env without web UI)
TUNNEL_TOKEN=
TUNNEL_HOSTNAME=

# Local debug
# setup.sh creates the first admin account during installation.
