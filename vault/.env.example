# Security
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REMEMBER_SESSION_DAYS=30

# Network
DOMAIN=localhost
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Metadata
TMDB_API_KEY=
TMDB_TOKEN=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT=StreamVaultDebug/1.0

# Infrastructure
CHECK_INTERVAL_MINUTES=30
HOST_DATA_ROOT=./data
# Optional: set BOTH to override the Git checkout's configured upstream.
# UPDATE_REMOTE names an existing remote; repository URLs are never guessed.
UPDATE_REMOTE=
UPDATE_BRANCH=
# Optional initial defaults. Admin UI settings are persisted under DATA_ROOT.
# branch preserves the existing behavior; release follows published stable tags.
UPDATE_MODE=branch
UPDATE_PROVIDER=auto
UPDATE_API_URL=
UPDATE_REPOSITORY=
UPDATE_CHECK_INTERVAL_HOURS=24
# Use /dev/null to disable the container's Docker access and apply updates from the host.
UPDATE_DOCKER_SOCKET=/var/run/docker.sock
CONCURRENT_DOWNLOADS=1
DOWNLOAD_RATE_LIMIT=4194304
TORRENT_UPLOAD_RATE_LIMIT=65536
TORRENT_MAX_PEERS=40
YTDLP_CONCURRENT_FRAGMENTS=5
DOWNLOADER_CPUS=1.0
DOWNLOADER_MEMORY_LIMIT=768m
DOWNLOADER_PIDS_LIMIT=128
DOWNLOADER_NOFILE_LIMIT=8192
CORE_CPUS=0.0
CORE_MEMORY_LIMIT=0
CORE_PIDS_LIMIT=384
CORE_NOFILE_LIMIT=16384
VIDEO_ENCODER=software
VIDEO_RENDER_DEVICE=/dev/dri/renderD128
TUNNEL_MEMORY_LIMIT=512m
TUNNEL_PROTOCOL=http2

# Playback/storage budgets. This reserve applies to physical free space,
# independently of the shared-download quota in Administration.
MIN_FREE_DISK_GB=2
MAX_CACHE_SIZE_GB=100
STORAGE_PROFILE=balanced
ABANDONED_DOWNLOAD_TTL_HOURS=1
BACKUP_RETENTION_DAYS=0
PLAYBACK_CACHE_RETENTION_HOURS=168
AUTO_CACHE_ON_WATCH=true
# Enabled with the bundled nginx read-only download mount; direct core access
# still uses authenticated FileResponse delivery.
MEDIA_ACCEL_REDIRECT=true

# Cloudflare Tunnel (Optional: activate tunnel directly from .env without web UI)
TUNNEL_TOKEN=
TUNNEL_HOSTNAME=

# Local debug
# setup.sh creates the first admin account during installation.
